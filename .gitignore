## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# Secrets and sensitive files
**/appsettings.json
**/appsettings.Development.json
**/appsettings.*.json
**/serviceAccountKey.json
*.pfx
*.key

# AWS credentials
**/.aws/

# Database files
*.db
*.sqlite

# Logs
logs/
*.log

# NuGet Packages
*.nupkg
**/packages/*

# JetBrains Rider
.idea/
*.sln.iml

# macOS
.DS_Store

# Windows
Thumbs.db
